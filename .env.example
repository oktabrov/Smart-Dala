# Configure at least one provider in Netlify/Vercel environment variables.
# Never put real keys in this file or in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# NVIDIA image-capable fallback. Override the model/endpoint if your catalog
# entitlement uses a different model.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/meta/llama-3.2-11b-vision-instruct

# Development only: RTSP cameras cannot be displayed directly by a browser.
# Put the real value in an ignored .env.local file or your shell, never in VITE_*.
# The Vite server exposes it only through same-origin /camera.mjpg on your LAN.
SMART_DALA_CAMERA_RTSP_URL=
